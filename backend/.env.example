DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional PostgreSQL configuration. Leave DB_ENGINE unset for local SQLite.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=hampayvand
# DB_USER=postgres
# DB_PASSWORD=change-this
# DB_HOST=127.0.0.1
# DB_PORT=5432

# SMS.ir production values. The adapter intentionally fails closed until the provider payload is configured/tested.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_LINE_NUMBER=
